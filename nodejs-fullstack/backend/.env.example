# Direct connection: Prisma CLI/migrations and raw SQL integration tests use this.
# Copy to .env and replace YOUR_PASSWORD with your local PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/game24?schema=public"
# Optional runtime pooler URL, pointing to the SAME database and schema.
# The application prefers this when non-empty; leave unset for local development.
# DATABASE_URL_POOLED="postgresql://USER:PASSWORD@POOLER_HOST:6432/game24?schema=public"
PORT=3000
# Comma-separated browser origins allowed to call the API directly.
FRONTEND_URL="http://localhost:5173"
