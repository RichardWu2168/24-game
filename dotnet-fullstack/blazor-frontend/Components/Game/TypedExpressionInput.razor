<div class="typed-expression-input mt-4">

    <h4>Expression</h4>

    <label for="typed-expression"
           class="form-label">
        Enter your mathematical expression:
    </label>

    <textarea id="typed-expression"
              class="form-control"
              rows="2"
              spellcheck="false"
              autocomplete="off"
              disabled="@Disabled"
              value="@Expression"
              @oninput="HandleInput">
    </textarea>

    <div class="form-text">
        Use the four card numbers exactly once.
        Available operators: +, -, *, /, (, ).
    </div>

    <div class="mt-3">
        <button type="button"
                class="btn btn-outline-danger"
                disabled="@(Disabled || string.IsNullOrEmpty(Expression))"
                @onclick="ClearAsync">
            Clear
        </button>
    </div>

</div>

@code {
    [Parameter]
    public string Expression { get; set; } = "";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<string> ExpressionChanged { get; set; }

    [Parameter]
    public EventCallback OnClear { get; set; }

    private async Task HandleInput(ChangeEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        string value = args.Value?.ToString() ?? "";

        await ExpressionChanged.InvokeAsync(value);
    }

    private async Task ClearAsync()
    {
        if (Disabled)
        {
            return;
        }

        await OnClear.InvokeAsync();
    }
}